# ──────────────────────────────────────────────────────────────────────────
# Переменные окружения QA-харнесса. Скопируй в .env и заполни.
# ВАЖНО: большинство раннеров НЕ читают .env автоматически — экспортируй переменные
# в окружение терминала (или `set -a; source .env; set +a`) перед запуском.
# prompt_id / prompt_version НЕ задаются здесь — они в tests/tools/model.yaml (источник правды).
# ──────────────────────────────────────────────────────────────────────────

# OpenAI API key. Нужен всем раннерам, которые ходят в LLM (step1 extractor, генераторы,
# классификаторы, first_touch и т.д.). Без него LLM-раннеры не стартуют.
OPENAI_API_KEY=

# (опционально) Кастомный OpenAI-совместимый эндпоинт. Пусто => https://api.openai.com/v1.
# Используется ядром llm_client (get_client) для всех LLM-вызовов.
OPENAI_BASE_URL=

# Backend AI-поиска кандидатов. Нужен раннерам, которые ходят в поиск:
#   extractor_agent (--steps 2,3), и будущим one_line_search_query_builder / sourcing_assistant.
# Это API-ХОСТ (эндпоинт собирается как {AI_SEARCH_BASE_URL}/site/searchBool),
# а НЕ веб-интерфейс. Для тестового стенда: https://testsecond.hlebusheck.ru
# (внимание: https://testsecond.podbor.io/search — это веб-UI, он редиректит на /auth, НЕ API).
AI_SEARCH_BASE_URL=

# Токен доступа к backend AI-поиска. Для этого бэкенда токен передаётся В ТЕЛЕ запроса
# (запускай раннер с флагом --token-in-body). Спрашивай актуальное значение у разработчика.
AI_SEARCH_AUTH_TOKEN=
