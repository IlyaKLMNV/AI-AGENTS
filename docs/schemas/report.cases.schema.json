{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ancor.ai/qa-harness/report.cases.schema.json",
  "title": "QA Harness — Cases / transcripts report",
  "description": "Heavy per-case drill-down. Pairs with report.metrics.schema.json via run_id / case_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "runner", "cases"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "kind": { "const": "cases" },
    "run_id": { "type": "string" },
    "runner": { "type": "string" },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator", "passed"],
      "properties": {
        "evaluator": { "type": "string", "description": "llm_judge | label_match | contract | deterministic | …" },
        "model": { "type": ["string", "null"] },
        "passed": { "type": "boolean" },
        "score": { "type": ["number", "null"] },
        "max_score": { "type": ["number", "null"] },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "comment": { "type": "string" },
        "turn_ref": { "type": ["integer", "null"] },
        "meta": { "type": "object", "description": "e.g. guardrails used_heuristics" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "passed"],
      "properties": {
        "rule": { "type": "string" },
        "passed": { "type": "boolean" },
        "severity": { "type": "string", "enum": ["high", "med", "low"] },
        "detail": { "type": "string" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source", "passed", "inputs", "verdict"],
      "properties": {
        "case_id": { "type": "string", "description": "stable, human-readable, unique per run; per-runner id-builder" },
        "source": { "type": "string", "enum": ["cdm", "regression", "synthetic", "suite", "real", "anchor", "golden"] },
        "passed": { "type": "boolean" },
        "inputs": {
          "type": "object",
          "required": ["criterion"],
          "properties": {
            "criterion": {
              "type": "string",
              "description": "Mandatory: the expected_behavior the judge measured against."
            },
            "scenario": { "type": "object" },
            "vacancy_ref": { "type": "object" },
            "cdm_file": { "type": "string" }
          }
        },
        "transcript": {
          "type": "array",
          "description": "Stored once; no cumulative dialog_text duplication.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "text"],
            "properties": {
              "turn": { "type": "integer" },
              "role": { "type": "string", "enum": ["candidate", "assistant", "recruiter", "system"] },
              "text": { "type": "string" },
              "flags": {
                "type": "object",
                "description": "guardrails per-turn multi-label markup",
                "additionalProperties": { "type": "boolean" }
              }
            }
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "raw": { "type": ["string", "null"] },
            "parsed": { "description": "structured prompt output for classifiers/autofill/search" }
          }
        },
        "verdict": { "$ref": "#/$defs/verdict" },
        "checks": {
          "type": "array",
          "description": "Optional deterministic layer on top of the verdict.",
          "items": { "$ref": "#/$defs/check" }
        },
        "subjects": {
          "type": "array",
          "description": "For sourcing: N candidates inside one vacancy-case.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string" },
              "passed": { "type": "boolean" },
              "verdict": { "$ref": "#/$defs/verdict" },
              "requirement_results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "requirement": { "type": "string" },
                    "passed": { "type": "boolean" },
                    "comment": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "stages": {
          "type": "array",
          "description": "For extractor/one_line: step1 -> step2 -> step3 pipeline.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "passed"],
            "properties": {
              "name": { "type": "string", "description": "step1_parse | step2_payload | step3_backend" },
              "artifact": { "description": "extractor_json / payload / backend response summary" },
              "passed": { "type": "boolean" },
              "reason_codes": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
